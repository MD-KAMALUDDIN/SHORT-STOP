flowchart TD
    UserAction([User Action]) --> AccessibilityEvent[Accessibility Event]
    AccessibilityEvent --> ShortStopService{ShortStopService}
    
    subgraph Service Layer
        ShortStopService --> DetectionEngine[Detection Engine]
        DetectionEngine -->|Panic/Doomscroll Detected| Decision[Decision Maker]
        Decision -->|Trigger| InterventionManager[Intervention Manager]
    end
    
    subgraph System Layer
        InterventionManager -->|Add View| WindowManager[WindowManager]
        WindowManager --> Overlay[Overlay View]
        Overlay -.->|Dim/Block| UserAction
    end
    
    subgraph Data Layer
        DetectionEngine -.->|Log| SessionDatabase[(Session DB)]
    end
